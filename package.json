{
  "name": "eleventy",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "eleventy",
    "start": "eleventy --serve",
    "compilePrivate": "ELEVENTY_MODE=compile eleventy --config=.eleventy.private.js --output=tmpPrivate && rm -rf src/private && mkdir -p src/private && cp -R tmpPrivate/* src/private/ && rm -rf tmpPrivate",
    "watchPrivate": "chokidar \"src/private-open/**/*\" -c \"npm run compilePrivate\"",
    "startWithPrivate": "run-p watchPrivate start",
    "compileImages": "node scripts/build-images.js",
    "r2": "node scripts/r2-manager.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@aws-sdk/client-s3": "^3.958.0",
    "chokidar-cli": "^3.0.0",
    "dotenv": "^17.2.3",
    "linkedom": "^0.18.12",
    "npm-run-all": "^4.1.5",
    "p-limit": "^7.2.0"
  },
  "dependencies": {
    "@11ty/eleventy-img": "^6.0.4",
    "gray-matter": "^4.0.3"
  }
}
