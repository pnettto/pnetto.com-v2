<ul class="post-list">
    {% for post in collections.logs | reverse %}
        <li class="post-item">
            <div class="post-item-header">
                <div class="post-main">
                    <a href="{{ post.url }}" class="post-title">{{
                        post.data.title
                    }}</a>
                </div>
                <span class="post-meta">{{ post.date | postDate }}</span>
            </div>

            <div class="tags-list mini-tags">
                {% for tag in post.data.tags %}
                    {# Exclude date categories #}
                    {% if tag != "post" and not tag.match("^[0-9]{4}") %}
                        <a
                            href="/logs/category/{{ tag | slug }}/"
                            class="badge"
                        >{{ tag }}</a>
                    {% endif %}
                {% endfor %}
            </div>
        </li>
    {% endfor %}
</ul>
