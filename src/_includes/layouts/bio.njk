---
layout: layouts/base.njk
containerClass: wide
---

<div class="bio">

{# ------------------------------------------------------------------
   Hero: split intro + featured visual (Reverb's "Latest article")
   ------------------------------------------------------------------ #}
{%
    set categories = ['Latest', 'Selected work', 'Logs', 'My journey', 'References', 'Toolbox', 'Other Skills']
%}
<a id="{{ "Start" | slugify }}" class="anchor"></a>
<section class="hero">
    <div class="hero-text">
        <span class="eyebrow">{{ header.eyebrow }}</span>
        <h1>{{ header.title | safe }}</h1>
        <div class="hero-lead">
            {{ intro.text | safe }}
        </div>
        <p class="hero-links">
            <a href="/cv" class="link-strong">Read my CV</a>
            <a href="#get-in-touch" class="link-strong">Get in touch</a>
        </p>
    </div>
    <nav class="quick-menu-home" aria-label="On this page">
        <ol>
            {% for category in categories %}
                <li>
                    <a href="#{{ category | slugify }}">
                        <span class="qm-num">{{ "0" if loop.index < 10 }}{{ loop.index }}</span>
                        <span class="qm-label">{{ category }}</span>
                        <span class="qm-arrow" aria-hidden="true">↓</span>
                    </a>
                </li>
            {% endfor %}
        </ol>
    </nav>
</section>

<div class="sticky-tags">
    <div class="container is-loaded tags-list">
        {% for category in categories %}
            <a href="#{{ category | slugify  }}" class="badge">{{
                category
            }}</a>
        {% endfor %}
    </div>
</div>

{# ------------------------------------------------------------------
   Now: full-bleed colour band (Reverb's "New pack")
   ------------------------------------------------------------------ #}
<a id="{{ "Latest" | slugify }}" class="anchor"></a>
<section class="bio-section band band-orange now-band">
    {% set live = recently | first %}
    <div class="now-main">
        <span class="eyebrow">{{ live.date }}</span>
        <h2 class="band-title">{{ live.title | safe }}</h2>
        <p>{{ live.text | safe }}</p>
        <p class="now-more"><a href="/now/" class="link-strong">See what else I'm up to</a></p>
    </div>
    <ol class="now-feed">
        {% for entry in recently %}
            {% if not loop.first %}
                <li>
                    <span class="now-date">{{ entry.date }}</span>
                    <p>{{ entry.text | safe }}</p>
                </li>
            {% endif %}
        {% endfor %}
    </ol>
</section>

{# ------------------------------------------------------------------
   Selected work: pastel cards (Reverb's "Featured packs")
   ------------------------------------------------------------------ #}
<a id="{{ "Selected work" | slugify }}" class="anchor"></a>
<section class="bio-section">
    <header class="section-head">
        <h2 class="section-title">Selected Work</h2>
        <a href="/work/" class="link-strong">All work</a>
    </header>
    <div class="places-grid">
        {% set tints = ['blue', 'green', 'yellow', 'peach', 'cream', 'cyan', 'lilac', 'grey'] %}
        {% for place in places %}
            <a href="{{ place.url }}" class="place-card tint-{{ tints[loop.index0 % tints.length] }}">
                {% set image = globalAllPhotos | matchPhotosource(place.image) %}
                <div class="place-card-image">
                    {% optmizedImageTag image, { sizes: "(min-width: 900px) 280px, (min-width: 600px) 45vw, 90vw", aspectRatio: '6 / 4' } %}
                    
                </div>
                {% if place.tag %}<span class="eyebrow place-card-tag">{{ place.tag }}</span>{% endif %}
                <div class="place-card-head">
                    <strong>{{ place.title }}</strong>
                    {% if place.years %}<span class="place-card-years">{{ place.years }}</span>{% endif %}
                </div>
                <span class="place-card-text">{{ place.text }}</span>
            </a>
        {% endfor %}
    </div>
</section>

{# ------------------------------------------------------------------
   Logs: dark band with outlined cards (Reverb's "Featured articles")
   ------------------------------------------------------------------ #}
<a id="{{ "Logs" | slugify }}" class="anchor"></a>
<section class="bio-section band band-dark">
    <header class="section-head">
        <h2 class="section-title">From the Logs</h2>
        <a href="/logs/" class="link-strong">All logs</a>
    </header>
    <div class="log-grid">
        {% for post in collections.logs | reverse %}
            {% if loop.index <= 4 %}
                <a href="{{ post.url }}" class="log-card">
                    <time datetime="{{ post.date | isoDate }}">{{ post.date | postDate }}</time>
                    <h3>{{ post.data.title }}</h3>
                    <p>{{ post.content | excerpt(140) }}</p>
                </a>
            {% endif %}
        {% endfor %}
    </div>
</section>

{# ------------------------------------------------------------------
   Journey: sticky title + ruled rows (Reverb's "Remake projects")
   ------------------------------------------------------------------ #}
<a id="{{ "My journey" | slugify }}" class="anchor"></a>
<section class="bio-section split">
    <div class="split-aside">
        <h2 class="section-title">My Journey</h2>
        <a href="/cv" class="link-strong">Download my CV</a>
    </div>
    <ol class="journey-list">
        {% for stop in journey %}
            <li class="journey-row">
                <div class="journey-place">
                    <span class="eyebrow">{{ stop.years }}</span>
                    <h3>{{ stop.place }}</h3>
                </div>
                <ul class="journey-highlights">
                    {% for item in stop.items %}
                        <li>{{ item | safe }}</li>
                    {% endfor %}
                </ul>
            </li>
        {% endfor %}
    </ol>
</section>

{# ------------------------------------------------------------------
   References: lilac band with a big serif quote
   ------------------------------------------------------------------ #}
<a id="{{ "References" | slugify }}" class="anchor"></a>
<section class="bio-section band band-lilac">
    {% set ref = (references | sort(attribute='data.order') | first) %}
    <figure class="reference-spotlight">
                <blockquote>{{ ref.content | safe }}</blockquote>
        <figcaption>
            <strong>{{ ref.data.referer }}</strong>
            <span>{{ ref.data.role }}, <a href="{{ ref.data.companyLink }}" target="_blank" rel="noopener">{{ ref.data.companyName }}</a></span>
        </figcaption>
        <a href="/references/" class="link-strong">Read all references</a>
    </figure>
</section>

{# ------------------------------------------------------------------
   Toolbox
   ------------------------------------------------------------------ #}
<a id="{{ "Toolbox" | slugify }}" class="anchor"></a>
<section class="bio-section">
    <header class="section-head">
        <h2 class="section-title">Toolbox</h2>
    </header>
    <div class="toolbox">
        {% for group in techSkills %}
            <div class="toolbox-group">
                <h3 class="eyebrow">{{ group.title }}</h3>
                <ul class="toolbox-tags">
                    {% for item in group.items %}
                        <li>{{ item }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endfor %}
    </div>
</section>

{# ------------------------------------------------------------------
   Other skills
   ------------------------------------------------------------------ #}
<a id="{{ "Other Skills" | slugify }}" class="anchor"></a>
<section class="bio-section">
    <header class="section-head">
        <h2 class="section-title">Other Skills</h2>
    </header>
    <div class="other-skills">
        {% for skill in otherSkills %}
            <div class="skill-group">
                <h3>{{ skill.title }}</h3>
                <p>{{ skill.text | safe }}</p>
            </div>
        {% endfor %}
    </div>
</section>

<a id="get-in-touch" class="anchor"></a>
</div>
