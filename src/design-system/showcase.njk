---
title: Design System
layout: layouts/protected.njk
containerClass: narrow
eleventyExcludeFromCollections: true
extraHeadScripts: |
  <script src="https://cdn.jsdelivr.net/npm/prismjs@1/prism.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/prismjs@1/components/prism-python.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/plyr@3/dist/plyr.css">
  <script defer src="https://cdn.jsdelivr.net/npm/plyr@3/dist/plyr.polyfilled.js"></script>
  <script defer src="/design-system/js/video.js"></script>
  <script>
    document.addEventListener("contentDecrypted", () => {
      if (typeof Prism !== "undefined") Prism.highlightAll();
      if (typeof Plyr !== "undefined" && typeof initVideoPlayers === "function") initVideoPlayers();
    });
  </script>
---

<article class="design-system-showcase">
    <h1>Design System</h1>
    <p class="intro-text">
        A modular, portable design system. Components and variables for
        consistent UI.
    </p>

    <hr>

    <section class="bio-section">
        <h2 class="underlined">Colors</h2>
        <div class="color-grid">
            <div class="color-swatch" style="background: var(--bg)">
                <span>--bg</span>
            </div>
            <div class="color-swatch" style="background: var(--bg-alt)">
                <span>--bg-alt</span>
            </div>
            <div
                class="color-swatch"
                style="background: var(--accent); color: var(--bg)"
            >
                <span>--accent</span>
            </div>
            <div
                class="color-swatch"
                style="background: var(--text); color: var(--bg)"
            >
                <span>--text</span>
            </div>
            <div
                class="color-swatch"
                style="background: var(--text-muted); color: var(--bg)"
            >
                <span>--text-muted</span>
            </div>
            <div class="color-swatch" style="background: var(--border)">
                <span>--border</span>
            </div>
        </div>
    </section>

    <section class="bio-section">
        <h2 class="underlined">Typography</h2>
        <h1>Heading 1 (--fs-2xl)</h1>
        <h2>Heading 2 (--fs-xl)</h2>
        <h3>Heading 3 (--fs-lg)</h3>
        <p>
            Body text using the default font size. This is --fs-base which
            scales responsively based on viewport width.
        </p>
        <p><small>Small text (--fs-sm) for metadata and captions.</small></p>
    </section>

    <section class="bio-section">
        <h2 class="underlined">Badges</h2>
        <ul class="tags-list">
            <li><a href="#" class="badge">Default</a></li>
            <li><a href="#" class="badge">Design</a></li>
            <li><a href="#" class="badge">Code</a></li>
            <li><a href="#" class="badge">Photography</a></li>
        </ul>
    </section>

    <section class="bio-section">
        <h2 class="underlined">Buttons & Navigation</h2>
        <p>
            <a href="#">Standard link</a> with default styling.
        </p>
        <p>
            <button
                class="nav-arrow"
                style="position: relative; transform: none"
            >
                ◀
            </button>
            <button
                class="nav-arrow"
                style="position: relative; transform: none"
            >
                ▶
            </button>
            Navigation arrows
        </p>
    </section>

    <section class="bio-section">
        <h2 class="underlined">Toggle Switch</h2>
        <div class="theme-switch-wrapper" style="margin-bottom: 1rem">
            <label
                class="theme-switch"
                for="demo-toggle"
                aria-label="Demo toggle"
            >
                <input type="checkbox" id="demo-toggle">
                <div class="slider"></div>
            </label>
            <span style="margin-left: 1rem">Theme toggle component</span>
        </div>
    </section>

    <section class="bio-section">
        <h2 class="underlined">Syntax Highlighting (Prism)</h2>
        <p>
            Code blocks with syntax highlighting. Prism.js applies highlighting
            at runtime:
        </p>
        <div class="code-container">
            <label class="language-label">javascript</label>
            <pre
                class="language-javascript"
            >
    <code class="language-javascript">const greeting = "Hello, World!";

function sayHello(name) {
return `Hello, ${name}!`;
}

console.log(sayHello("Design System"));</code></pre>
        </div>
    </section>

    <section class="bio-section">
        <h2 class="underlined">Code Runner</h2>
        <p>Interactive code execution with syntax highlighting:</p>

        <div class="code-container code-runner" data-language-name="python">
            <label class="language-label">Python</label>
            <div class="code-header">Fibonacci Example</div>
            <pre
                class="language-python"
            >
<code class="language-python">def fibonacci(n):
    a, b = 0, 1
    for _ in range(n):
        print(a, end=' ')
        a, b = b, a + b

fibonacci(10)</code></pre>
            <button onclick="runCode(this)">Run</button>
            <div class="code-output"></div>
        </div>

        <div class="code-container code-runner" data-language-name="node">
            <label class="language-label">Node</label>
            <pre
                class="language-javascript"
            >
<code class="language-javascript">const numbers = [1, 2, 3, 4, 5];
const doubled = numbers.map(n => n * 2);
console.log("Doubled:", doubled);</code></pre>
            <button onclick="runCode(this)">Run</button>
            <div class="code-output"></div>
        </div>
    </section>

    <section class="bio-section">
        <h2 class="underlined">Video Player (Plyr)</h2>
        <p>
            Video component with Plyr integration. Add <code
            >.project-video</code> class to auto-initialize:
        </p>
        <div class="video-wrapper">
            <video class="project-video" playsinline controls muted>
                <source src="/assets/media/hawk_demo.mp4" type="video/mp4">
            </video>
            <p class="caption">Demo video with Plyr controls</p>
        </div>
    </section>

    <section class="bio-section">
        <h2 class="underlined">Timeline</h2>
        <div class="timeline">
            <div class="timeline-item">
                <div class="timeline-year">2024</div>
                <p>Current work and projects. Building design systems.</p>
            </div>
            <div class="timeline-item">
                <div class="timeline-year">2023</div>
                <p>Previous milestones and achievements.</p>
            </div>
            <div class="timeline-item">
                <div class="timeline-year">2022</div>
                <p>Earlier work and experience.</p>
            </div>
        </div>
    </section>

    <section class="bio-section">
        <h2 class="underlined">Cards</h2>
        <div class="project-grid" style="grid-template-columns: repeat(2, 1fr)">
            <div class="project-card">
                <div
                    class="project-card-image-wrapper"
                    style="background: var(--bg-alt); aspect-ratio: 16/9"
                >
                </div>
                <div class="project-card-content">
                    <h3>Project Card</h3>
                    <div class="project-card-meta">
                        <div class="meta-item"><strong>Type:</strong> Demo</div>
                    </div>
                    <p class="project-card-description">
                        A card component for projects.
                    </p>
                </div>
            </div>
            <div class="project-card">
                <div
                    class="project-card-image-wrapper"
                    style="background: var(--bg-alt); aspect-ratio: 16/9"
                >
                </div>
                <div class="project-card-content">
                    <h3>Another Card</h3>
                    <div class="project-card-meta">
                        <div class="meta-item">
                            <strong>Type:</strong> Example
                        </div>
                    </div>
                    <p class="project-card-description">
                        Cards adapt to content.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="bio-section">
        <h2 class="underlined">Quick Menu</h2>
        <div class="quick-menu">
            <ul>
                <li><a href="#">Link One</a></li>
                <li><a href="#">Link Two</a></li>
                <li><a href="#">Link Three</a></li>
            </ul>
        </div>
    </section>

    <section class="bio-section">
        <h2 class="underlined">Spacing Scale</h2>
        <div
            style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-end"
        >
            <div
                style="width: var(--sp-xs); height: var(--sp-xs); background: var(--accent)"
                title="--sp-xs"
            >
            </div>
            <div
                style="width: var(--sp-sm); height: var(--sp-sm); background: var(--accent)"
                title="--sp-sm"
            >
            </div>
            <div
                style="width: var(--sp-md); height: var(--sp-md); background: var(--accent)"
                title="--sp-md"
            >
            </div>
            <div
                style="width: var(--sp-lg); height: var(--sp-lg); background: var(--accent)"
                title="--sp-lg"
            >
            </div>
            <div
                style="width: var(--sp-xl); height: var(--sp-xl); background: var(--accent)"
                title="--sp-xl"
            >
            </div>
        </div>
        <p
            style="margin-top: 1rem; font-size: var(--fs-sm); color: var(--text-muted)"
        >
            --sp-xs, --sp-sm, --sp-md, --sp-lg, --sp-xl
        </p>
    </section>

    <section class="bio-section">
        <h2 class="underlined">Utility Classes</h2>
        <ul>
            <li><code>.container</code> — centered max-width wrapper</li>
            <li><code>.container.narrow</code> — narrower variant</li>
            <li><code>.fade-in</code> — opacity transition on scroll</li>
            <li><code>.legend</code> — overlay label for images</li>
            <li>
                <code>.mobile-hide</code> / <code>.mobile-show</code> —
                responsive visibility
            </li>
        </ul>
    </section>
</article>

<style>
    .color-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: var(--sp-sm);
        margin-top: var(--sp-md);
    }
    .color-swatch {
        aspect-ratio: 1;
        border-radius: var(--radius);
        display: flex;
        align-items: flex-end;
        padding: var(--sp-xs);
        font-size: var(--fs-xs);
        border: 1px solid var(--border);
    }
    .color-swatch span {
        background: rgba(0, 0, 0, 0.5);
        padding: 2px 6px;
        border-radius: 4px;
        color: white;
    }
</style>
